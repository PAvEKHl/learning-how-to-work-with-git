# === Зависимости (страховка, у каждого подпроекта есть свой .gitignore) ===
node_modules/

# === Сборка / артефакты ===
dist/
build/
.next/
out/

# === Переменные окружения (секреты НИКОГДА не должны попадать в Git) ===
.env
.env.*
!.env.example

# === Логи и системный мусор ===
*.log
.DS_Store
Thumbs.db
